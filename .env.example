# Local development (Docker Postgres — run `docker compose up -d` first)
DATABASE_URL=postgresql://payload:payload@localhost:5432/vashabid_dev

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=generate-a-long-random-string

# Set to false when pointing at staging/production (VPS) databases.
# Push auto-syncs schema in dev only — never enable on shared DBs.
DATABASE_PUSH=true

# Staging/production: set DATABASE_URL and PAYLOAD_SECRET in your deploy
# platform secrets (Coolify, Vercel, etc.). Do not use VPS credentials locally.
